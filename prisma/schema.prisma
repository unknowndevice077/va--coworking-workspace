generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      @default("VA")
  createdAt    DateTime    @default(now())
  timeEntries  TimeEntry[]
}

model Client {
  id           String   @id @default(cuid())
  name         String
  contactName  String
  contactEmail String
  status       String   @default("ACTIVE")
  monthlyValueCents Int @default(0)
  services     String
  portalToken  String   @unique @default(cuid())
  createdAt    DateTime @default(now())

  // Real client login, layered on top of the token-link portal above
  // without touching it: `passwordHash` is null until the client sets up
  // their account via a one-time `setupToken` (see /client/setup/[token]),
  // at which point they get a proper session (src/lib/client-auth.ts) and
  // /p/[token] keeps working unauthenticated exactly as it always has.
  passwordHash        String?
  setupToken          String?   @unique
  setupTokenExpiresAt DateTime?
  accountCreatedAt    DateTime?

  projects        Project[]
  invoices        Invoice[]
  events          CalendarEvent[]
  threads         MessageThread[]
  files           ClientFile[]
  designApprovals DesignApproval[]
}

model Project {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  status    String    @default("TODO")
  dueLabel  String?
  createdAt DateTime  @default(now())

  timeEntries TimeEntry[]
}

model TimeEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  minutes   Int
  date      DateTime @default(now())
  note      String?
}

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amountCents Int
  status      String    @default("DRAFT")
  dueLabel    String?
  createdAt   DateTime  @default(now())

  // Set once a client pays via Stripe Checkout (src/lib/stripe.ts, the
  // /api/webhooks/stripe route handler) — status still just flips to the
  // same "PAID" string markPaidAction already writes, so nothing else has
  // to branch on "was this paid manually or via Stripe."
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
}

model CalendarEvent {
  id       String   @id @default(cuid())
  clientId String?
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title    String
  day      String
  startHour Float
  endHour   Float
  allDay    Boolean @default(false)
}

model MessageThread {
  id        String    @id @default(cuid())
  clientId  String    @unique
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromVA    Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())
}

model ClientFile {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  filename  String
  sizeLabel String
  createdAt DateTime @default(now())
}

// A VA's private, in-progress design — a free-form Canva-like canvas. Never
// queried from any client-facing route (/p/[token] only ever reads
// DesignApproval); a Design becomes visible to a client only once the VA
// explicitly sends it, which snapshots its content into a DesignApproval.
// `doc` is a CanvasDoc (src/lib/canvas-doc/types.ts): { width, height,
// background, elements: DesignElement[] } — the whole free-form canvas
// state. `templateId` (when a design started from a preset) is just a
// label for display; presets live in code, not the database.
model Design {
  id         String   @id @default(cuid())
  templateId String?
  name       String
  doc        Json
  promptText String   @default("")
  status     String   @default("DRAFT") // DRAFT | SENT
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  approvals DesignApproval[]
}

model DesignApproval {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId String?
  designId   String?
  design     Design?  @relation(fields: [designId], references: [id], onDelete: SetNull)
  doc        Json
  status     String   @default("PENDING")
  promptText String
  createdAt  DateTime @default(now())

  comments DesignComment[]
}

// Free-text back-and-forth on a sent design, alongside its Approve/Request
// changes status — same fromVA shape as Message, so a client can say *why*
// they requested changes, not just flip a status. Only reachable from the
// authenticated /client area (src/lib/client-auth.ts); the legacy
// unauthenticated /p/[token] link keeps its original approve-only actions.
model DesignComment {
  id         String         @id @default(cuid())
  approvalId String
  approval   DesignApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  fromVA     Boolean        @default(false)
  body       String
  createdAt  DateTime       @default(now())
}

// A VA's private video project — a sequence of clips (video or image) on
// one track, each with an optional text overlay. `doc` is a VideoDoc
// (src/lib/video-doc/types.ts): { width, height, clips: VideoClip[] }.
// Clip media is stored as data URIs inside `doc` itself, same approach as
// Design's `doc` — simplest thing that works at this project's scale, no
// object storage to wire up.
model VideoProject {
  id        String   @id @default(cuid())
  name      String
  doc       Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
